+    ({                                                                                                                 \
+        (void)(fd);                                                                                                    \
+        ksyscall(close, fd);                                                                                           \
+    })
+#define ksu_sys_setns(fd, flags)                                                                                       \
+    ({                                                                                                                 \
+        ksyscall(setns, fd, flags);                                                                                    \
+    })
+#define ksu_sys_unshare(flags)                                                                                         \
+    ({                                                                                                                 \
+        ksyscall(unshare, flags);                                                                                      \
+    })
