From 3c1d2e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d Mon Sep 17 00:00:00 2001
From: indramccaslin <indramccaslin@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:25:00 +0700
Subject: [PATCH] net: ipv4: add TCP_CONG_BBR2 config (BBRv2 backport)

Add Kconfig entries for the experimental BBRv2 congestion control
backport and allow it to be selected as the default TCP congestion
control.

The previous version of this patch had wrong hunk line numbers, so the
DEFAULT_BBR2 choice symbol and the "bbr2" default string were silently
dropped by patch --fuzz; olddefconfig then picked DEFAULT_CUBIC instead.
This version is generated against the actual 17.0-stable-perf Kconfig.

---
 net/ipv4/Kconfig | 23 +++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

--- a/net/ipv4/Kconfig
+++ b/net/ipv4/Kconfig
@@ -686,9 +686,26 @@
 	bufferbloat, policers, or AQM schemes that do not provide a delay
 	signal. It requires the fq ("Fair Queue") pacing packet scheduler.
 
+config TCP_CONG_BBR2
+	tristate "BBRv2 TCP (experimental)"
+	default n
+	depends on TCP_CONG_ADVANCED
+	---help---
+	  BBRv2 is the next generation of BBR. It adds loss/ECN response and
+	  better coexistence with Reno/CUBIC.
+	
+	  This is an experimental backport of the Google bbr v2alpha code
+	  from Linux 5.13 to this 4.14 kernel. It is not upstream and has
+	  not been exhaustively tested on mobile hardware.
+	
+	  BBRv2 REQUIRES the fq packet scheduler (CONFIG_NET_SCH_FQ) for
+	  correct pacing. Do not enable it with pfifo_fast/fq_codel only.
+	
+	  If unsure, say N.
+
 choice
 	prompt "Default TCP congestion control"
-	default DEFAULT_CUBIC
+	default DEFAULT_BBR2
 	help
 	  Select the TCP congestion control that will be used by default
 	  for all connections.
@@ -723,6 +740,9 @@
 	config DEFAULT_BBR
 		bool "BBR" if TCP_CONG_BBR=y
 
+	config DEFAULT_BBR2
+		bool "BBR2" if TCP_CONG_BBR2=y
+
 	config DEFAULT_RENO
 		bool "Reno"
 endchoice
@@ -747,6 +767,7 @@
 	default "dctcp" if DEFAULT_DCTCP
 	default "cdg" if DEFAULT_CDG
 	default "bbr" if DEFAULT_BBR
+	default "bbr2" if DEFAULT_BBR2
 	default "cubic"
 
 config TCP_MD5SIG
